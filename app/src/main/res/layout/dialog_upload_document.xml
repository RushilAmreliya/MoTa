<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload Document to Wallet"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Store certificates in your secure digital vault. Only PDF files (.pdf) are accepted."
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDocType"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Document Type / Title *"
        android:textColorHint="#94A3B8"
        app:hintTextColor="#FFFFFF"
        app:boxStrokeColor="#64748B"
        app:boxStrokeWidth="1dp"
        app:endIconTint="#FFFFFF"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/actvDocType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:popupBackground="#1E293B"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDocNumber"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Certificate / Document Number *"
        android:textColorHint="#94A3B8"
        app:hintTextColor="#FFFFFF"
        app:boxStrokeColor="#64748B"
        app:boxStrokeWidth="1dp"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDocAuthority"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Issuing Authority"
        android:textColorHint="#94A3B8"
        app:hintTextColor="#FFFFFF"
        app:boxStrokeColor="#64748B"
        app:boxStrokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocAuthority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="State e-District / DigiLocker Central"
            android:textColor="#FFFFFF"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- File Picker Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#334155"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseFile"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose PDF"
            android:textColor="#FFFFFF"
            app:backgroundTint="#475569"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="No PDF selected"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="middle" />
    </LinearLayout>

</LinearLayout>
